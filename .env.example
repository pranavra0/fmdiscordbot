# Required for the Discord bot and Last.fm integration
DISCORD_TOKEN=
LASTFM_API_KEY=
LASTFM_API_SECRET=


# Optional local runtime configuration
DB_FILE=users.json
DISCORD_CHANNEL_ID=
# Set true only if this process should own Friday scheduling.
# Leave false when using .github/workflows/weekly-update.yml.
ENABLE_INTERNAL_SCHEDULER=false
WEEKLY_USERNAMES=
